# Скопируйте в .env и заполните (НЕ коммитьте .env в git!)

TELEGRAM_BOT_TOKEN=123456:ABC...
# ID чата, куда слать отчёты. Узнать: напишите боту /chatid
TELEGRAM_CHAT_ID=

# Personal API key PostHog (phx_...), Settings -> Personal API Keys
POSTHOG_API_KEY=phx_...
POSTHOG_PROJECT_ID=498457
POSTHOG_HOST=https://us.posthog.com

# Часовой пояс и час отправки ежедневного отчёта
REPORT_TZ=Europe/Moscow
REPORT_HOUR=9

APP_NAME=Mockup Clothing

# Имена событий можно переопределить (через запятую — считаются все найденные).
# Реальные имена смотрите командой /events в боте.
#EVENTS_APP_OPENED=Application Opened,app_opened
#EVENTS_EDITOR_OPENED=editor_opened
#EVENTS_PURCHASE=purchase_completed
#EVENTS_PAYWALL_SHOWN=paywall_shown
#EVENTS_MOCKUP_SAVED=mockup_saved
#EVENTS_AI_GENERATION=ai_generation
#GARMENT_PROPS=garment,garment_name
#PAYWALL_SOURCE_PROPS=source,paywall_source

# 0 — отключить чтение команд из Telegram (останется только рассылка)
#ENABLE_POLLING=1

# ---- RevenueCat: уведомления о покупках (POST /revenuecat) ----
# Секрет, который RevenueCat присылает в заголовке Authorization
REVENUECAT_WEBHOOK_AUTH=
# Secret API key sk_... — только чтобы показывать названия приложений
REVENUECAT_API_KEY=
# Отдельный чат для покупок (по умолчанию — TELEGRAM_CHAT_ID)
#REVENUECAT_CHAT_ID=
# Какие события не присылать, через запятую (например EXPIRATION,BILLING_ISSUE)
#REVENUECAT_SKIP_EVENTS=
# 1 — не присылать тестовые покупки из sandbox
#REVENUECAT_SKIP_SANDBOX=0
